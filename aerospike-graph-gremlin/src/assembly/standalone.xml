<assembly>
    <id>standalone</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>target/*.jar</directory>
            <outputDirectory>/lib</outputDirectory>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/ext/tinkergraph-gremlin/plugin</outputDirectory>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <includes>
                <include>org.apache.tinkerpop:tinkergraph-gremlin</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>/ext/gremlin-groovy/plugin</outputDirectory>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <includes>
                <include>org.apache.tinkerpop:gremlin-groovy</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>/ext/tinkergraph-gremlin/lib</outputDirectory>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <includes>
                <include>org.apache.tinkerpop:tinkergraph-gremlin</include>
            </includes>
        </dependencySet>
        <dependencySet>
            <outputDirectory>/ext/gremlin-groovy/lib</outputDirectory>
            <unpack>false</unpack>
            <scope>runtime</scope>
            <includes>
                <include>org.apache.tinkerpop:gremlin-groovy</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
